{
  "name": "diorama",
  "version": "0.1.0",
  "description": "Turn a story prompt into playable painted point-and-click scenes with Meta Muse and SAM 3.1",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "diorama": "app/bin/diorama.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "diorama": "node app/bin/diorama.mjs",
    "setup": "node app/bin/diorama.mjs setup",
    "doctor": "node app/bin/diorama.mjs doctor",
    "studio": "node app/bin/diorama.mjs studio",
    "build": "node app/bin/diorama.mjs build",
    "play": "node app/bin/diorama.mjs play",
    "publish": "node app/bin/diorama.mjs publish",
    "export": "node app/bin/diorama.mjs export",
    "browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit -p app && tsc --noEmit -p app/web && tsc --noEmit -p app/studio",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@preact/signals": "^2.11.3",
    "esbuild": "^0.25.0",
    "genaicode": "^2.25.0",
    "onnxruntime-node": "^1.22.0",
    "preact": "^10.29.8",
    "sharp": "^0.33.5",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
