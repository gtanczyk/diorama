{
  "name": "diorama",
  "version": "0.1.0",
  "description": "Turn a story prompt into playable painted point-and-click scenes with Meta Muse and SAM 3.1",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "diorama": "bin/diorama.mjs"
  },
  "engines": {
    "node": ">=22"
  },
